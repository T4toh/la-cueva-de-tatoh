/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": [
      "vitest/globals"
    ],
    /* El Worker de `/r/*` es JS plano —lo empaqueta wrangler, no el builder de
       Angular—, y `worker-og.spec.ts` importa sus funciones puras. Sin
       `checkJs`: sólo hace falta que resuelva. */
    "allowJs": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "worker/**/*.js"
  ]
}
