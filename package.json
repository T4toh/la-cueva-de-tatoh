{
  "name": "la-cueva-de-tatoh",
  "version": "1.4.1",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build componentes && ng build perfil-personal --configuration=production && ng build comidas --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test comidas",
    "lint": "ng lint",
    "check:libros": "node scripts/check-libros.mjs",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:comidas": "ng build comidas --configuration=production",
    "build:comidas:android": "ng build comidas --configuration=production && npx cap sync android",
    "open:android": "npm run build:comidas:android && npx cap open android"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@angular/ssr": "22.1.5",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "firebase": "^12.18.0",
    "marked": "^18.0.11",
    "ngx-markdown": "^22.0.0",
    "prismjs": "^1.30.0",
    "qr-code-styling": "^1.9.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.1.11"
  }
}
